{
  // 연구노트 (Research Note) — Cloudflare Workers + D1
  // 배포 전: `npm run setup` 이 D1 을 만들고 아래 database_id 를 채워 넣는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-note",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*", "/health", "/SKILL.md", "/skill", "/skill.md", "/mcp.json", "/connect", "/connect.md", "/ai", "/llms.txt"]
  },
  // SKILL.md 를 문자열 모듈로 임포트 (src/skill.ts)
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "research-note-db",
      "database_id": "367ffba7-6220-40b8-8575-2020cf29efbc",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 화면 상단 기관/연구실 표기 (필요시 수정)
    "APP_NAME": "연구노트",
    "ORG_NAME": "한국외국어대학교",
    "ORG_SUB": "Global Business & Technology",
    "ORG_MARK": "GBT",
    // 날짜 기본값 계산용 타임존
    "APP_TZ": "Asia/Seoul",
    // 공개 토큰 발급 신청 페이지(/#/apply) 허용 여부. "false" 면 관리자 직접 등록만 가능
    "SIGNUP_ENABLED": "true",
    // 토큰 재발급(/#/reissue): "true" 면 등록한 이름+이메일이 일치할 때 즉시 발급, "false" 면 관리자 승인 후 수령
    "REISSUE_AUTO": "true"
  },
  "observability": { "enabled": true }
  // 비밀값(소스에 두지 않음):
  //   wrangler secret put ADMIN_TOKEN   # 최초 관리자 토큰(부트스트랩). DB 관리자 생성 후 삭제 가능
  //   wrangler secret put SIGNUP_CODE   # (선택) 발급 신청 시 입력해야 하는 신청 코드 (스팸 방지)
}
